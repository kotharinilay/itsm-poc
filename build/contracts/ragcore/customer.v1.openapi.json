          },
          "501": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Record Result Api Customer V1 Work  Workitemid  Result Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Record Result",
        "tags": [
          "customer"
        ]
      }
    }
  }
}
