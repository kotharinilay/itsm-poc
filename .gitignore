bin/
obj/
*.user
*.suo
*.userprefs
artifacts/
TestResults/
*.trx
*.coverage
*.coverlet.json
coverage*.xml
coverage*.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
