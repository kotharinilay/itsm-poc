# Constitution §.NET baseline — IDE0055 (formatting) and IDE1006 (naming) are errors, not
# suggestions. `dotnet format --verify-no-changes` is a merge gate, so a formatting drift fails CI.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

[*.{cs,csx}]
indent_size = 4
max_line_length = 120

[*.{csproj,props,targets,json,yml,yaml,xml}]
indent_size = 2

[*.cs]

#### Formatting — IDE0055 as an error ####
dotnet_diagnostic.IDE0055.severity = error

csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_between_query_expression_clauses = true
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_space_after_cast = false
csharp_space_after_keywords_in_control_flow_statements = true
csharp_preserve_single_line_blocks = true

#### Naming — IDE1006 as an error ####
dotnet_diagnostic.IDE1006.severity = error

dotnet_naming_rule.types_pascal.symbols = type_symbols
dotnet_naming_rule.types_pascal.style = pascal_case
dotnet_naming_rule.types_pascal.severity = error
dotnet_naming_symbols.type_symbols.applicable_kinds = class,struct,interface,enum,delegate
dotnet_naming_symbols.type_symbols.applicable_accessibilities = *

dotnet_naming_rule.interfaces_prefixed.symbols = interface_symbols
dotnet_naming_rule.interfaces_prefixed.style = i_prefixed
dotnet_naming_rule.interfaces_prefixed.severity = error
dotnet_naming_symbols.interface_symbols.applicable_kinds = interface

dotnet_naming_rule.members_pascal.symbols = member_symbols
dotnet_naming_rule.members_pascal.style = pascal_case
dotnet_naming_rule.members_pascal.severity = error
dotnet_naming_symbols.member_symbols.applicable_kinds = method,property,event
dotnet_naming_symbols.member_symbols.applicable_accessibilities = *

dotnet_naming_rule.private_fields_underscore.symbols = private_field_symbols
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = error
dotnet_naming_symbols.private_field_symbols.applicable_kinds = field
dotnet_naming_symbols.private_field_symbols.applicable_accessibilities = private
dotnet_naming_symbols.private_field_symbols.required_modifiers = readonly

dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.i_prefixed.capitalization = pascal_case
dotnet_naming_style.i_prefixed.required_prefix = I
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

#### Style — constructor injection, explicit types at boundaries ####
csharp_prefer_braces = true:error
dotnet_style_readonly_field = true:warning
csharp_style_prefer_primary_constructors = false:suggestion
csharp_style_namespace_declarations = file_scoped:error
dotnet_style_require_accessibility_modifiers = for_non_interface_members:error
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning

#### Banned patterns the constitution names explicitly ####
# Enforced properly by architecture tests (T034); the analyzer severities below catch the
# common cases at build time so the feedback is immediate rather than at test time.

# CA2007 — ConfigureAwait. Not required in ASP.NET Core; off deliberately, not by oversight.
dotnet_diagnostic.CA2007.severity = none
# CA2016 — forward CancellationToken. Constitution requires propagation at EVERY async boundary.
dotnet_diagnostic.CA2016.severity = error
# CA1849 — call async methods in an async context (catches .Result and .Wait()).
dotnet_diagnostic.CA1849.severity = error
# CA1031 — do not catch general exception types.
dotnet_diagnostic.CA1031.severity = error
# CA1062 — validate arguments of public methods.
dotnet_diagnostic.CA1062.severity = warning
# CA1848 — prefer LoggerMessage delegates on high-volume paths.
dotnet_diagnostic.CA1848.severity = suggestion

[*.{cs}]
# Test projects keep identical strictness (constitution §.NET baseline), so no relaxations here.

[tests/**/*.cs]
# CA1707 — underscores in member names. Test method names read as sentences; this is the one
# documented relaxation and it applies to naming only, never to correctness analyzers.
dotnet_diagnostic.CA1707.severity = none
