{
  "name": "@synthia/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Synthia desktop host — Electron. Thin, hardened, decides nothing.",
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "npm run build:main && npm run build:preload",
    "build:main": "tsc -p tsconfig.json",
    "build:preload": "esbuild src/preload/bridge.ts --bundle --platform=node --target=node20 --format=cjs --external:electron --outfile=dist/preload/bridge.js",
    "stage:renderer": "node scripts/stage-renderer.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.preload.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:security": "bash ../../build/scripts/verify-desktop-security-guard.sh",
    "lint": "eslint .",
    "start": "npm run build && npm run stage:renderer && electron ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.2",
    "electron": "^44.4.0",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^8.0.0",
    "vitest": "^5.0.1"
  }
}
