    "/api/customer/v1/sessions/{sessionId}/answers": {
      "post": {
        "description": "Answer a pending clarifying question.\n\n**Returns 501 until the run loop is hosted.** The interrupt node, its payload contract and the\nbounded answer are implemented and unit-tested; what is missing is the process that holds a\ncompiled graph and resumes it, which is the run host — not this endpoint. Wiring a resume here\nagainst a graph nobody compiled would be a route that appears to work and silently drops the\nanswer, which is worse than one that says it is not there.\n\nWhat this signature already fixes, and what a later wiring cannot therefore get wrong: the\nanswerer comes from ``principal`` and the organisation from ``tenant``, both derived from\ntrusted identity; neither is a parameter a client can supply.",
        "operationId": "answer_clarification_api_customer_v1_sessions__sessionId__answers_post",
        "parameters": [
          {
            "description": "The chat session.",
            "in": "path",
            "name": "sessionId",
            "required": true,
            "schema": {
              "description": "The chat session.",
              "format": "uuid",
              "title": "Sessionid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnswerRequest"
              }
            }
