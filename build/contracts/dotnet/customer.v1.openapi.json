  "paths": {
    "/api/customer/v1/views/sessions": {
      "get": {
        "tags": [
          "customer-views"
        ],
        "summary": "Lists the caller\u0027s own sessions. Cursor paged.",
        "operationId": "CustomerListSessions",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/customer/v1/views/sessions/{sessionId}": {
      "get": {
        "tags": [
          "customer-views"
        ],
        "summary": "Reads one of the caller\u0027s own sessions.",
        "operationId": "CustomerGetSession",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/customer/v1/views/sessions/{sessionId}/messages": {
      "get": {
        "tags": [
          "customer-views"
        ],
