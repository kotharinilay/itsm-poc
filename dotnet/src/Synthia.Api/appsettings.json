{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReadDatabase": {
    "CommandTimeoutSeconds": 30,
    "EnableSensitiveDataLogging": false
  },
  "Observability": {
    "ServiceName": "synthia-monolith",
    "DeploymentEnvironment": "development"
  },
  "KeyVault": {
    "ReloadIntervalMinutes": 60
  },
  "ContainerApps": {
    "ShutdownTimeoutSeconds": 25,
    "Port": 8080
  }
}
