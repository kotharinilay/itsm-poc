                  "$ref": "#/components/schemas/ProblemContract"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemContract"
                }
              }
            },
            "description": "Not Found"
          },
          "500": {
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemContract"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Reads the current thumbs signals on a session\u0027s agent messages.",
        "tags": [
          "customer-views"
        ]
      }
