{
  "components": {
    "schemas": {
      "ApprovalVerdict": {
        "description": "What a human decided on an approval request (``data-model.md``, ``approval.verdict``).\n\n**Exactly two members, and that is load-bearing.** This is deliberately NOT\n:class:`ApprovalState`, which is the work item's field and also carries ``pending`` and\n``expired``. Typing a verdict as that enum would let ``record_verdict(EXPIRED)`` type-check —\na system-synthesized verdict, which §17.7 and FR-INTR-008 prohibit outright:\n\n    \"No timeout, no auto-reject, no system-synthesized verdict.\"\n\nExpiry is a work-item transition performed by the expiry sweeper. It is never a recorded human\ndecision, and ``approved_by`` always means a human approved (§17.8).\n\nThere is no ``REJECT_AND_TAKE_OVER`` member either. §17.6 lists it as a staff *action*, but it\nis a rejection plus a session transition to ``staff_controlled`` — two things, recorded\nseparately. A third verdict value would make the takeover invisible to anything reading the\nverdict alone.",
        "enum": [
          "approved",
          "rejected"
        ],
        "title": "ApprovalVerdict",
        "type": "string"
      },
      "ProblemDetails": {
        "additionalProperties": false,
        "description": "The RFC 9457 error body, declared so it appears in every emitted document.\n\n**The document has to say what an error looks like, or the contract is only half emitted.**\n:mod:`ragcore.api.middleware.problems` already returns this shape at runtime; without a model\nthe generator falls back to FastAPI's ``HTTPValidationError``, and the published contract then\ndescribes an error body the service never sends.\n\nMirrors ``Synthia.Contracts.Errors.ProblemContract`` on the .NET side field for field, because a\nclient calls both deployables and must parse one error contract, not two.\n\n``correlationId`` is the one addition to RFC 9457, and it is what lets a user quoting an error\nbe followed across an asynchronous, suspendable flow (spec FR-OPS-001).",
        "properties": {
          "correlationId": {
            "title": "Correlationid",
            "type": "string"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instance"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "correlationId"
        ],
        "title": "ProblemDetails",
        "type": "object"
      },
      "StaffMessageRequest": {
        "additionalProperties": false,
        "description": "A message sent into a taken-over session.",
        "properties": {
          "content": {
            "title": "Content",
            "type": "string"
          }
        },
        "required": [
          "content"
        ],
        "title": "StaffMessageRequest",
        "type": "object"
      },
      "VerdictRequest": {
        "additionalProperties": false,
        "description": "A staff decision on one approval.\n\n``verdict`` is :class:`~ragcore.domain.work.ApprovalVerdict` — **two members**. There is no\n``expired`` to send, so a system-synthesized verdict is unrepresentable on this contract\nrather than merely prohibited by it (spec FR-INTR-008).\n\nDeliberately absent: ``decidedBy``, ``roles``, ``tenantId``, ``expiresAt``. The approver is\nthe authenticated caller, the roles are the ones they hold at this moment, the organisation\ncomes from the approval's own work item, and the window is computed server-side as\n``decided_at`` plus fifteen minutes. Every one of those is authority, and none of them is a\nthing a request may assert.",
        "properties": {
          "note": {
            "default": "",
            "title": "Note",
            "type": "string"
          },
          "verdict": {
            "$ref": "#/components/schemas/ApprovalVerdict"
          }
        },
        "required": [
          "verdict"
        ],
        "title": "VerdictRequest",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "The staff audience. Generated from the running service; not hand-maintained. Identity is derived at the gateway and no operation accepts a tenant, role or audience parameter.",
    "title": "Synthia Staff API",
    "version": "v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/staff/v1/approvals/{approvalId}/verdict": {
      "post": {
        "description": "Approve or reject. Accepts ``technician``.\n\nThree properties this route commits to, all enforced below it rather than here:\n\n* **First valid verdict wins.** A later one is recorded but does not change the outcome\n  (spec FR-INTR-010), which the repository's conditional write decides — two staff opening\n  the same queue item is a race, not an error.\n* **Approval never executes.** On approval the window is set and a trigger is published, and\n  **the request returns before execution runs**. A response reporting success would be\n  reporting something that has not happened.\n* **No approval by timeout.** Nothing anywhere produces a verdict except this route.",
        "operationId": "record_verdict_api_staff_v1_approvals__approvalId__verdict_post",
        "parameters": [
          {
            "description": "The approval being decided.",
            "in": "path",
            "name": "approvalId",
            "required": true,
            "schema": {
              "description": "The approval being decided.",
              "format": "uuid",
              "title": "Approvalid",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerdictRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unauthenticated"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Not authorized"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Not found"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Invalid request"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Internal error"
          },
          "501": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Not implemented"
          }
        },
        "summary": "Record Verdict",
        "tags": [
          "staff"
        ]
      }
    },
