    "/api/staff/v1/sessions/{sessionId}/takeover": {
      "post": {
        "description": "Transition a session to staff-controlled. Accepts ``technician``.\n\nAn authenticated state transition, not a socket message, and a **single** transition: where\ntwo staff attempt it concurrently one wins and the other is told (spec FR-INTR-013).\n\nIt does **not** transfer requester authority. Consent for that user's own account or device\nstill belongs to the original end user, so a taken-over session does not become a route by\nwhich staff consent on somebody's behalf.",
        "operationId": "take_over_session_api_staff_v1_sessions__sessionId__takeover_post",
        "parameters": [
          {
            "description": "The session being operated on.",
            "in": "path",
            "name": "sessionId",
            "required": true,
            "schema": {
