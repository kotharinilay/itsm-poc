<!--
  STAFF API (/api/staff/v1) - APIM policy.

  Runs after the global policy. Derives identity for the staff audience and states it in the closed
  contract.

  TWO THINGS MAKE THIS AUDIENCE DIFFERENT FROM THE CUSTOMER ONE, and both are structural rather
  than remembered:

    1. Single-tenant. The staff application registration lives in the Operator tenant and accepts
       only it. A user from a customer tenant cannot obtain a token for this API at all, so
       "staff capability is granted only to Operator-tenant users" is enforced by Entra before any
       policy here runs.

    2. The role set survives whole. A principal holding {administrator, technician} arrives as
       both. COLLAPSING THE SET TO ONE VALUE DESTROYS AUTHORITY (spec 11.5): arriving as
       "administrator" alone silently loses the capability that lets them approve. The expression
       below therefore emits every mapped role, never a "highest" one - there is no highest, the
       roles are disjoint capability sets and not a hierarchy (A1 §6).
-->
<policies>
  <inbound>
    <base />

    <validate-azure-ad-token
        tenant-id="{{operator-tenant-id}}"
        header-name="Authorization"
        output-token-variable-name="jwt"
        failed-validation-httpcode="401"
        failed-validation-error-message="Unauthorized">
      <client-application-ids>
        <application-id>{{staff-client-application-id}}</application-id>
      </client-application-ids>
      <audiences>
        <audience>{{staff-api-audience}}</audience>
      </audiences>
      <required-claims>
        <!-- Delegated only. See customer.v1.xml for why scp is the discriminator. -->
        <claim name="scp" match="any">
          <value>{{staff-api-scope}}</value>
        </claim>
      </required-claims>
    </validate-azure-ad-token>

    <set-header name="X-Idp-Tenant-Id" exists-action="override">
      <value>@(((Jwt)context.Variables["jwt"]).Claims.GetValueOrDefault("tid", ""))</value>
    </set-header>
    <set-header name="X-Idp-Principal-Id" exists-action="override">
      <value>@(((Jwt)context.Variables["jwt"]).Claims.GetValueOrDefault("oid", ""))</value>
    </set-header>

    <!--
      ROLE DERIVATION. Entra app roles map to platform roles by the initial-release assignment
      fixed in A1 §6.2: Synthia_Agents -> technician, Synthia_Admins -> administrator.
      senior_technician is a defined role that no Entra group maps to yet and no operation accepts
      yet; it is absent here rather than aliased onto another role, because aliasing it would grant
      capability that was never assigned.

      CANONICAL ORDER IS A SECURITY PROPERTY, NOT TIDINESS (spec 11.5). Sorting ordinally here is
      what makes "token array order never decides anything" checkable at the backend boundary
      rather than trusted: the backend refuses an unordered set, so a policy that forgot to sort
      fails loudly instead of forwarding whatever order Entra happened to emit.

      Lowercase, comma-separated, no spaces. The backend's parser does not trim, so a stray space
      here is a refusal rather than a repair.
    -->
    <set-variable name="platformRoles" value="@{
        var claims = ((Jwt)context.Variables["jwt"]).Claims;
        string[] entraRoles = claims.ContainsKey("roles") ? claims["roles"] : new string[0];
        var mapped = new List<string>();
        if (System.Array.IndexOf(entraRoles, "Synthia_Admins") >= 0) { mapped.Add("administrator"); }
        if (System.Array.IndexOf(entraRoles, "Synthia_Agents") >= 0) { mapped.Add("technician"); }
        mapped.Sort(System.StringComparer.Ordinal);
        return string.Join(",", mapped);
    }" />

    <!--
      An Operator-tenant user holding no mapped role is authenticated and unauthorized. Refused at
      the gateway (sequence step 6, spec 11.4) rather than forwarded as an empty role set, because
      the contract has no spelling for "staff with no roles": the sentinel `none` belongs to the
      workload audience, and reusing it here would make a person indistinguishable from a machine
      in every downstream audit record.
    -->
    <choose>
      <when condition="@(string.IsNullOrEmpty((string)context.Variables["platformRoles"]))">
        <return-response>
          <set-status code="403" reason="Forbidden" />
          <set-header name="Content-Type" exists-action="override">
            <value>application/problem+json</value>
          </set-header>
          <set-body>@("{\"type\":\"https://synthia.synoptek.com/problems/forbidden\",\"title\":\"Forbidden\",\"status\":403,\"detail\":\"This identity holds no staff role.\"}")</set-body>
        </return-response>
      </when>
    </choose>

    <set-header name="X-Idp-Roles" exists-action="override">
      <value>@((string)context.Variables["platformRoles"])</value>
    </set-header>

    <set-header name="X-Idp-Credential-Class" exists-action="override">
      <value>delegated</value>
    </set-header>

    <set-header name="X-Idp-Client-Surface" exists-action="override">
      <value>@(((Jwt)context.Variables["jwt"]).Claims.GetValueOrDefault("azp", ""))</value>
    </set-header>

    <choose>
      <when condition="@(string.IsNullOrEmpty(context.Request.Headers.GetValueOrDefault("X-Idp-Tenant-Id", "")) || string.IsNullOrEmpty(context.Request.Headers.GetValueOrDefault("X-Idp-Principal-Id", "")))">
        <return-response>
          <set-status code="401" reason="Unauthorized" />
          <set-header name="Content-Type" exists-action="override">
            <value>application/problem+json</value>
          </set-header>
          <set-body>@("{\"type\":\"https://synthia.synoptek.com/problems/unauthenticated\",\"title\":\"Unauthenticated\",\"status\":401,\"detail\":\"The token carried no usable identity.\"}")</set-body>
        </return-response>
      </when>
    </choose>

    <!--
      PER-ORGANISATION RATE AND BUDGET BOUNDARY (spec FR-OPS-005, plan §Constraints).
      Placed HERE, after identity derivation, and that position is the whole control.

      The global policy already rate-limits by IP, and that bounds an anonymous flood before it
      costs gateway capacity. It cannot do this job: one organisation behind one NAT is one IP, and
      fifty users of another organisation are fifty. Counting by IP therefore throttles the wrong
      people and protects nobody from a noisy neighbour, which is precisely what FR-OPS-005
      prohibits — no single organisation's load may degrade another's service.

      The counter key is the DERIVED X-Idp-Tenant-Id, never a caller-supplied value. It cannot be
      read before this point because it does not exist before this point: the global policy deleted
      every inbound copy, and the header above is the first one APIM itself wrote. A budget keyed on
      anything a caller can set is a budget a caller can escape by changing it.

      A THROTTLE IS NOT A FAILURE (spec FR-OPS-006). 429 and 403 from here mean the request was
      LIMITED, and the user must be told that rather than told their request failed. The Retry-After
      header below is what makes that actionable rather than merely true.

      This is the request budget. The TOKEN budget is enforced at the AI Gateway, on the same
      per-organisation key (build/infra/ai-gateway/policy.xml) — two different resources, two
      different meters, deliberately not merged: model spend and request volume fail for different
      reasons and at different rates.
    -->
    <rate-limit-by-key
        calls="{{staff-calls-per-minute}}"
        renewal-period="60"
        counter-key="@(context.Request.Headers.GetValueOrDefault("X-Idp-Tenant-Id", string.Empty))"
        remaining-calls-header-name="X-RateLimit-Remaining"
        retry-after-header-name="Retry-After" />

    <quota-by-key
        calls="{{staff-calls-per-day}}"
        renewal-period="86400"
        counter-key="@(context.Request.Headers.GetValueOrDefault("X-Idp-Tenant-Id", string.Empty))" />
  </inbound>

  <backend><base /></backend>
  <outbound><base /></outbound>
  <on-error><base /></on-error>
</policies>
