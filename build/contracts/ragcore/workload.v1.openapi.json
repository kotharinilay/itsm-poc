{
  "components": {
    "schemas": {
      "OutcomeRequest": {
        "additionalProperties": false,
        "description": "The outcome of one execution attempt.\n\n``verification`` is **mandatory and has no default**. That is the whole design of this schema:\na caller must state what the platform actually knows, and the absence of a default means \"we\ndid not check\" cannot be silently recorded as success.\n\nA ``client_attested`` outcome MUST NOT be reported to a user or written to the system of\nrecord as confirmed resolution (ADR-0004). It is a claim; the field name says so.",
        "properties": {
          "detail": {
            "additionalProperties": true,
            "title": "Detail",
            "type": "object"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "verification": {
            "$ref": "#/components/schemas/VerificationOutcome"
          }
        },
        "required": [
          "status",
          "verification"
        ],
        "title": "OutcomeRequest",
        "type": "object"
      },
      "ProblemDetails": {
        "additionalProperties": false,
        "description": "The RFC 9457 error body, declared so it appears in every emitted document.\n\n**The document has to say what an error looks like, or the contract is only half emitted.**\n:mod:`ragcore.api.middleware.problems` already returns this shape at runtime; without a model\nthe generator falls back to FastAPI's ``HTTPValidationError``, and the published contract then\ndescribes an error body the service never sends.\n\nMirrors ``Synthia.Contracts.Errors.ProblemContract`` on the .NET side field for field, because a\nclient calls both deployables and must parse one error contract, not two.\n\n``correlationId`` is the one addition to RFC 9457, and it is what lets a user quoting an error\nbe followed across an asynchronous, suspendable flow (spec FR-OPS-001).",
        "properties": {
          "correlationId": {
            "title": "Correlationid",
            "type": "string"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instance"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "correlationId"
        ],
        "title": "ProblemDetails",
        "type": "object"
      },
      "VerificationOutcome": {
        "description": "What the platform actually knows about an execution's outcome.\n\nA client-reported result is a claim, not proof. The platform MUST NOT claim to know more\nthan it does (constitution Principle VIII, ADR-0004).",
        "enum": [
          "server_confirmed",
          "client_attested",
          "contradicted"
        ],
        "title": "VerificationOutcome",
        "type": "string"
      }
    }
  },
  "info": {
    "description": "The workload audience. Generated from the running service; not hand-maintained. Identity is derived at the gateway and no operation accepts a tenant, role or audience parameter.",
    "title": "Synthia Workload API",
    "version": "v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/workload/v1/work/{workItemId}/claim": {
      "post": {
        "description": "Atomically claim a work item. 409 if already claimed, expired, or not authorized.\n\n**Idempotency boundary 1**, and the one that absorbs at-least-once delivery: a conditional\nupdate on ``claimed_at IS NULL``, so a duplicate trigger produces exactly one execution.\nBoundary 2 — the idempotency key carried to the external system — protects the far side and\ndoes not substitute for this.",
        "operationId": "claim_work_api_workload_v1_work__workItemId__claim_post",
        "parameters": [
          {
            "description": "The durable work record.",
            "in": "path",
            "name": "workItemId",
            "required": true,
            "schema": {
              "description": "The durable work record.",
              "format": "uuid",
              "title": "Workitemid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "401": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Unauthenticated"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Not authorized"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Not found"
          },
          "409": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Already claimed"
          },
          "410": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Authorization expired"
          },
          "422": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Invalid request"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Internal error"
          },
          "501": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Not implemented"
          }
        },
        "summary": "Claim Work",
        "tags": [
          "workload"
        ]
      }
    },
